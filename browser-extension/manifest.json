{
  "manifest_version": 3,
  "name": "Apple Pickup Watcher",
  "version": "0.2.0",
  "description": "自动加车，并在 Apple 结账页填充本机保存的取货及配送资料。",
  "permissions": ["storage"],
  "action": {
    "default_title": "Apple 结账资料",
    "default_popup": "popup.html"
  },
  "options_page": "profile.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.apple.com/shop/*",
        "https://www.apple.com/*/shop/*",
        "https://www.apple.com.cn/shop/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.apple.com/shop/*",
        "https://www.apple.com/*/shop/*",
        "https://www.apple.com.cn/shop/*",
        "https://*.store.apple.com/shop/*",
        "https://*.store.apple.com.cn/shop/*"
      ],
      "js": ["profile-fill.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
